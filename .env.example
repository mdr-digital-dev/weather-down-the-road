# Copy to .env and adjust. Every value has a working default; none are required.

# Port the server listens on
PORT=3000

# Upstream services. All are free and keyless. Swap in your own instances if you self-host.
OSRM_BASE=https://router.project-osrm.org
PHOTON_BASE=https://photon.komoot.io
OPEN_METEO_BASE=https://api.open-meteo.com

# Identify yourself to upstream APIs. Nominatim-family services require a real contact.
USER_AGENT=weather-down-the-road/2.0 (your-email@example.com)

# Cache lifetimes in seconds
CACHE_TTL_GEOCODE=86400
CACHE_TTL_ROUTE=3600
CACHE_TTL_WEATHER=600

# Rate limit per client IP: requests per window
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=60
